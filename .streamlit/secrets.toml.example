# Copy to .streamlit/secrets.toml for local use (git-ignored). On Streamlit Community Cloud,
# paste the same lines into App settings -> Secrets. Never commit real keys.
RAG_GENERATOR = "openai:gemini-3.5-flash-lite"
RAG_OPENAI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai"
RAG_OPENAI_API_KEY = "paste-your-key-here"
RAG_MAX_RETRIES = "2"
DAILY_CAP = "150"
SESSION_CAP = "10"
